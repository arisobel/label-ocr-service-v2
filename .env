# Copie este arquivo para .env e preencha os dados do seu servidor.
# O arquivo .env contem um token e fica ignorado pelo Git.

# URL do painel CapRover (nao a URL publica da aplicacao).
CAPROVER_URL=https://captain.lib.adar.com.br
# CAPROVER_URL=https://captain.lion.app.br

# Nome exato do aplicativo no CapRover.
CAPROVER_APP=ocr-samples
# CAPROVER_APP=pwa-fair

# App Token gerado em CapRover > Apps > seu app > Deployment.
CAPROVER_APP_TOKEN=2db25d40c390390cb46c56d666acbfda44804ad3c6c7ef6ee190eb969c2468ba
# CAPROVER_APP_TOKEN=e0720a7fee972ddbbd5e78351480b097c38f763a1a0745e8dd2c0d0f43fda538
